{
	"name": "kuma-sync",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Reconciles Dokploy domains into Uptime Kuma HTTP monitors",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx --env-file=.env src/index.ts",
		"domains": "tsx --env-file=.env src/bin/domains.ts",
		"inspect": "tsx --env-file=.env src/bin/inspect.ts",
		"start": "node --env-file=.env dist/index.js",
		"build": "rimraf dist && tsc",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test src/*.test.ts"
	},
	"dependencies": {
		"otplib": "^12.0.1",
		"pino": "^9.5.0",
		"postgres": "^3.4.5",
		"socket.io-client": "^4.8.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"pino-pretty": "^13.0.0",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}
