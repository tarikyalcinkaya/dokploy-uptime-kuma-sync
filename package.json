{
  "name": "dokploy-uptime-kuma-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Reconciles Dokploy domains into Uptime Kuma HTTP monitors",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "domains": "tsx --env-file=.env src/bin/domains.ts",
    "inspect": "tsx --env-file=.env src/bin/inspect.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "arch": "depcruise src --validate",
    "coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:integration": "scripts/integration.sh"
  },
  "dependencies": {
    "otplib": "12.0.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
