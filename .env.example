# NO QUOTES around values. `docker run --env-file` does not strip them — it would read the quote
# characters as part of the value. (They are stripped defensively, but keep this file honest.)
# Inline comments are not supported either: everything after `=` is the value.

# --- Dokploy -----------------------------------------------------------------
# Read-only role recommended. From inside Dokploy's own network the host is `dokploy-postgres`.
# Percent-encode special characters in the password: @ = %40, # = %23, : = %3A, / = %2F, ? = %3F
DATABASE_URL=postgres://kuma_sync:CHANGE_ME@dokploy-postgres:5432/dokploy

# --- Uptime Kuma -------------------------------------------------------------
KUMA_URL=https://kuma.example.com
KUMA_USERNAME=admin
KUMA_PASSWORD=CHANGE_ME
# Only if 2FA is enabled on the Kuma account — the account's base32 TOTP secret.
# KUMA_TOTP_SECRET=

# Kuma notification ids to attach to every managed monitor (Settings -> Notifications).
# Without this the monitors are created but nothing alerts you.
# Run `npm run inspect` to list the ids — Kuma's UI does not show them.
KUMA_NOTIFICATION_IDS=1

# Push URL of a Kuma "Push" monitor. Pinged after every applied cycle, so Kuma alerts you when the
# sync itself stops working — otherwise the sync is the blind spot in your alerting.
# Create it in Kuma: Add New Monitor -> Monitor Type "Push" -> set Heartbeat Interval above your
# cron interval (e.g. cron every 15 min -> heartbeat 1800s) -> copy the Push URL here.
# Skipped while DRY_RUN=true, since a dry run applies nothing and must not look healthy.
# KUMA_PUSH_URL=https://kuma.example.com/api/push/CHANGE_ME

# --- Behaviour ---------------------------------------------------------------
# Leave on until you have seen a plan you agree with.
DRY_RUN=true

# once = run one cycle and exit (host cron / Dokploy schedule)
# loop = stay running and reconcile every INTERVAL_SECONDS
RUN_MODE=once
INTERVAL_SECONDS=900

# pause keeps the monitor and its history; delete removes it for good.
ON_REMOVE=pause

# Refuse to retire more than this fraction of managed monitors in a single run.
MAX_RETIRE_RATIO=0.5

MONITOR_INTERVAL_SECONDS=60
MONITOR_RETRIES=2
MONITOR_TIMEOUT_SECONDS=16

LOG_LEVEL=info
