# NO QUOTES around values. `docker run --env-file` does not strip them — it would read the quote
# characters as part of the value. (They are stripped defensively, but keep this file honest.)
# Inline comments are not supported either: everything after `=` is the value.

# --- Dokploy -----------------------------------------------------------------
# Read-only role recommended. From inside Dokploy's own network the host is `dokploy-postgres`.
# Percent-encode special characters in the password: @ = %40, # = %23, : = %3A, / = %2F, ? = %3F
DATABASE_URL=postgres://kuma_sync:CHANGE_ME@dokploy-postgres:5432/dokploy

# --- Uptime Kuma -------------------------------------------------------------
# https, or plain http only to localhost or a Docker service name (http://uptime-kuma:3001) — the
# admin password travels over this connection. No user:pass in the URL.
KUMA_URL=https://kuma.example.com
KUMA_USERNAME=admin
KUMA_PASSWORD=CHANGE_ME
# Only if 2FA is enabled on the Kuma account — the account's base32 TOTP secret.
# KUMA_TOTP_SECRET=

# Kuma notification ids to attach to every managed monitor (Settings -> Notifications).
# Without this the monitors are created but nothing alerts you.
# Run `pnpm inspect` to list the ids — Kuma's UI does not show them.
KUMA_NOTIFICATION_IDS=1

# Push URL of a Kuma "Push" monitor. Pinged after every applied cycle, so Kuma alerts you when the
# sync itself stops working — otherwise the sync is the blind spot in your alerting.
# Create it in Kuma: Add New Monitor -> Monitor Type "Push" -> set Heartbeat Interval comfortably
# above INTERVAL_SECONDS (900s cycles -> heartbeat 1800s) -> copy the Push URL here.
# Skipped while DRY_RUN=true, since a dry run applies nothing and must not look healthy.
# KUMA_PUSH_URL=https://kuma.example.com/api/push/CHANGE_ME

# --- Behaviour ---------------------------------------------------------------
# Leave on until you have seen a plan you agree with.
DRY_RUN=true

# loop = stay running and reconcile every INTERVAL_SECONDS — the way to run it on Dokploy.
# once = one cycle and exit, for trying it out by hand. Do not schedule `once` with cron and
# `docker run --rm`: Dokploy's image cleanup deletes the image between runs (see README).
RUN_MODE=once
INTERVAL_SECONDS=900

# pause keeps the monitor and its history; delete removes it for good.
ON_REMOVE=pause

# true = one Kuma group per Dokploy project, monitors named `service · host` inside it.
# false = one flat list, monitors named `project · service · host`.
GROUP_BY_PROJECT=true

# Services whose root answers 401/404 by design. `host=value` pairs, comma separated; `*` matches
# anything (dots included) and the first matching pattern wins. A health path replaces the domain's
# own path; status codes are `|` separated, otherwise 200-299.
# HEALTH_PATHS=api.example.com=/health,mta-sts.*=/.well-known/mta-sts.txt,autoconfig.*=/mail/config-v1.1.xml
# ACCEPTED_STATUS_CODES=admin.example.com=200-299|401

# Domains that are never monitored, comma separated, `*` as wildcard. A monitor whose domain becomes
# excluded is retired like a removed one. VPN-only services (an ipAllowList middleware) are
# unreachable from Kuma by design, so exclude their middleware.
# EXCLUDE_MIDDLEWARES=vpn-only@file
# EXCLUDE_HOSTS=autodiscover.*,autoconfig.*
# EXCLUDE_PROJECTS=
# EXCLUDE_SERVICES=

# Refuse to retire more than this fraction of managed monitors in a single run.
MAX_RETIRE_RATIO=0.5

# The project's default environment is checked every MONITOR_INTERVAL_SECONDS, other environments
# (staging and the like) every MONITOR_INTERVAL_SECONDS_OTHER_ENVS.
MONITOR_INTERVAL_SECONDS=120
MONITOR_INTERVAL_SECONDS_OTHER_ENVS=300
MONITOR_RETRIES=2
MONITOR_TIMEOUT_SECONDS=16
# Alert before an HTTPS certificate expires.
MONITOR_EXPIRY_NOTIFICATION=true

LOG_LEVEL=info
# json for log collectors, pretty for reading in a terminal.
LOG_FORMAT=json
